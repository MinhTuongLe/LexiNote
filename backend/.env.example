# Backend Port
PORT=1337

# Environment (development/production)
NODE_ENV=development

# Allowed Origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:1337


# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_here

# Postgres Database URL (Supabase/Neon/Local)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Email Configuration (Brevo HTTPS API - Port 443)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
SENDER_EMAIL=your_brevo_registered_email@gmail.com

