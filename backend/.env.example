# Backend Port
PORT=1337

# Environment (development/production)
NODE_ENV=development

# Allowed Origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:1337


# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_here

# Postgres Database URL (Supabase/Neon/Local)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# SMTP Mail Server Configuration (Optional - falls back to Console Logging if unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="LexiNote" <no-reply@lexinote.app>

