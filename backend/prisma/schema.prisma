generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

enum ModerationStatus {
  APPROVED
  PENDING
  REJECTED
  NEEDS_EDIT
}

enum ModerationFlagReason {
  MISSING_EXAMPLE
  SHORT_MEANING
  FLAGGED
}

enum GameType {
  MATCH_GAME
}

model User {
  id                       Int      @id @default(autoincrement())
  email                    String   @unique
  password                 String
  fullName                 String   @map("full_name")
  avatar                   String?  @default("🐰")
  role                     Role     @default(MEMBER)
  isActive                 Boolean  @default(true) @map("is_active")
  resetPasswordToken       String?  @map("reset_password_token")
  resetPasswordExpires     BigInt?  @map("reset_password_expires")
  isEmailVerified          Boolean  @default(false) @map("is_email_verified")
  emailVerificationToken   String?  @map("email_verification_token")
  emailVerificationExpires BigInt?  @map("email_verification_expires")
  createdAt                BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))
  updatedAt                BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))
  settings                 Json?    @default("{}") @db.Json
  status                   String   @default("active")
  banReason                String?  @map("ban_reason")
  
  words                    Word[]
  refreshTokens            RefreshToken[]
  achievementUnlocks       AchievementUnlock[]
  gameSessions             GameSession[]
  createdDecks             Deck[]

  @@map("user")
}

model Word {
  id               Int                   @id @default(autoincrement())
  word             String
  meaningVi        String                @map("meaning_vi")
  example          String?
  type             String                @default("noun")
  phonetic         String?               @map("phonetic")
  audioUrl         String?               @map("audio_url")
  ownerId          Int                   @map("owner")
  moderationStatus ModerationStatus     @default(APPROVED) @map("moderation_status")
  flagReason       ModerationFlagReason? @map("flag_reason")
  rejectReason     String?               @map("reject_reason")
  createdAt        BigInt                @default(dbgenerated("extract(epoch from now()) * 1000"))
  updatedAt        BigInt                @default(dbgenerated("extract(epoch from now()) * 1000"))

  owner       User     @relation(fields: [ownerId], references: [id])
  relations   WordRelation[]
  reviews     Review[]

  @@unique([word, ownerId])
  @@index([ownerId])
  @@map("word")
}

model Deck {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String   @default("GENERAL")
  level       String?  @default("Intermediate")
  coverImage  String?  @map("cover_image")
  isCurated   Boolean  @default(true) @map("is_curated")
  creatorId   Int?     @map("creator_id")
  createdAt   BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))
  updatedAt   BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))

  creator     User?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  words       DeckWord[]

  @@index([category])
  @@index([isCurated])
  @@map("deck")
}

model DeckWord {
  deckId    Int      @map("deck_id")
  word      String
  meaningVi String   @map("meaning_vi")
  type      String   @default("noun")
  phonetic  String?
  example   String?
  audioUrl  String?  @map("audio_url")
  createdAt BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))

  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([deckId, word])
  @@map("deck_word")
}

model WordRelation {
  id        Int      @id @default(autoincrement())
  wordId    Int      @map("word")
  type      String
  value     String
  createdAt BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))
  updatedAt BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))

  word      Word     @relation(fields: [wordId], references: [id])

  @@index([wordId])
  @@map("wordrelation")
}

model Review {
  id             Int      @id @default(autoincrement())
  wordId         Int      @unique @map("word")
  interval       Int      @default(0)
  easeFactor     Float    @default(2.5) @map("ease_factor")
  correctCount   Int      @default(0) @map("correct_count")
  wrongCount     Int      @default(0) @map("wrong_count")
  lastReviewed   BigInt?  @map("last_reviewed")
  nextReview     BigInt   @default(dbgenerated("extract(epoch from now()) * 1000")) @map("next_review")
  createdAt      BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))
  updatedAt      BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))

  word           Word     @relation(fields: [wordId], references: [id])

  @@index([nextReview])
  @@map("review")
}

model archive {
  id               Int     @id @default(autoincrement())
  createdAt        BigInt?
  fromModel        String?
  originalRecord   Json?   @db.Json
  originalRecordId Json?   @db.Json
}

model RefreshToken {
  id               Int      @id @default(autoincrement())
  hashedToken      String   @map("hashed_token")
  userId           Int      @map("user_id")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  expiresAt        BigInt   @map("expires_at")
  createdAt        BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hashedToken])
  @@map("refresh_token")
}

model AchievementUnlock {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    BigInt   @default(dbgenerated("extract(epoch from now()) * 1000")) @map("unlocked_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("achievement_unlock")
}

model GameSession {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  gameType          GameType @default(MATCH_GAME) @map("game_type")
  score             Int
  timeSpentSeconds  Int      @map("time_spent_seconds")
  wordIds           Json     @map("word_ids") @db.Json
  createdAt         BigInt   @default(dbgenerated("extract(epoch from now()) * 1000")) @map("created_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameType, createdAt])
  @@index([userId, gameType, score])
  @@map("game_session")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  actorEmail String?  @map("actor_email")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?    @db.Json
  ipAddress  String?  @map("ip_address")
  createdAt  BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model SystemConfig {
  id                  Int      @id @default(1)
  isMaintenanceMode   Boolean  @default(false) @map("is_maintenance_mode")
  isRegistrationOpen  Boolean  @default(true) @map("is_registration_open")
  rateLimit           Int      @default(100)
  corsEnabled         Boolean  @default(true) @map("cors_enabled")
  createdAt           BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))
  updatedAt           BigInt   @default(dbgenerated("extract(epoch from now()) * 1000"))

  @@map("system_config")
}
